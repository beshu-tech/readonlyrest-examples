# Minimum ReadonlyREST license edition required to run this example (FREE, PRO, ENT).
# If the detected license is lower, run.sh will exit with an error.
ROR_MIN_LICENSE_EDITION=FREE

# ES/KBN ROR_PLUGIN_SOURCE options:
#   API        - download ReadonlyREST plugin from API (requires ROR_ES_VERSION / ROR_KBN_VERSION)
#   LOCAL_FILE - use a local plugin file (requires ROR_ES_FILE / ROR_KBN_FILE)

# Personal API keys are not in a released ReadonlyREST yet, so both plugins ship with this repository.
# The zips are in runner/plugins/, because the Docker build context is runner/. The paths are relative to it.
# To rebuild them, see "Rebuild the ROR plugins" in README.md.
ES_VERSION=9.5.6
ROR_ES_PLUGIN_SOURCE=LOCAL_FILE
ROR_ES_FILE=plugins/readonlyrest-1.74.0-pre2_es9.5.6.zip

KBN_VERSION=9.5.6
ROR_KBN_PLUGIN_SOURCE=LOCAL_FILE
ROR_KBN_FILE=plugins/readonlyrest_kbn_universal-1.74.0-pre1_es9.5.6.zip
