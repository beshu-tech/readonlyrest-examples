# PKI authentication is not in a released ReadonlyREST yet, so this example runs a locally built
# plugin. Build it first, from the elasticsearch-readonlyrest-plugin repository:
#
#   ./gradlew clean buildRorPlugin '-PesVersion=9.4.4'
#
# then point ROR_ES_FILE at the zip it produces under es94x/build/distributions/.
# Only the es94x module implements PKI so far, so ES_VERSION has to be one it supports (9.4.x, 9.5.0).
ROR_MIN_LICENSE_EDITION=FREE

ES_VERSION=9.4.4
ROR_ES_PLUGIN_SOURCE=LOCAL_FILE
ROR_ES_FILE=/path/to/elasticsearch-readonlyrest-plugin/es94x/build/distributions/readonlyrest-1.71.0-pre5_es9.4.4.zip

# Kibana is here so a human can log in with a password while the services authenticate by certificate
# on the same port. PKI itself is demonstrated with curl - certificates are for machine-to-machine
# traffic, and Kibana never presents one.
#
# NOTE: the ES plugin above is built locally and the Kibana plugin is downloaded, so the two ReadonlyREST
# versions can drift. If Kibana fails to talk to ES, align them - either publish/point at a matching
# Kibana plugin, or switch this to LOCAL_FILE with ROR_KBN_FILE.
KBN_INSTANCES=1
KBN_VERSION=9.4.4
ROR_KBN_PLUGIN_SOURCE=API
ROR_KBN_VERSION=1.69.1
